APP_NAME=YayasanApp
APP_ENV=production
APP_KEY=<SET_ON_PRODUCTION_SERVER>
APP_DEBUG=false
APP_URL=https://<PRODUCTION_DOMAIN>
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
 
DB_CONNECTION=pgsql
DB_HOST=<PRODUCTION_DB_HOST>
DB_PORT=5432
DB_DATABASE=<PRODUCTION_DB_NAME>
DB_USERNAME=<PRODUCTION_DB_USERNAME>
DB_PASSWORD=<SET_ON_PRODUCTION_SERVER>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=<PRODUCTION_DOMAIN>

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=<PRODUCTION_MAIL_FROM>
MAIL_FROM_NAME="${APP_NAME}"

# Legacy SIDIKMA harus read-only dan hanya diaktifkan bila diperlukan untuk migrasi.
SIDIKMA_OLD_DB_HOST=<LEGACY_DB_HOST>
SIDIKMA_OLD_DB_PORT=3306
SIDIKMA_OLD_DB_DATABASE=<LEGACY_DB_NAME>
SIDIKMA_OLD_DB_USERNAME=<READ_ONLY_USERNAME>
SIDIKMA_OLD_DB_PASSWORD=<SET_ON_PRODUCTION_SERVER>

# Jangan commit file .env production. Isi nilai di secret manager atau server production.
